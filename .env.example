# ============================================================
# AirQuality Guardian - environment template
# Copy to .env and fill in. NEVER commit the real .env.
# ============================================================

# ------------------------------------------------------------
# MongoDB (Atlas)
# MONGODB_URI = full connection string, e.g.
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/DATABASE?appName=Cluster0
# The database name inside the URI is the source of truth for
# "which database"; MONGODB_DATABASE below is an explicit override
# (the code reads MONGODB_DATABASE, not MONGODB_DATABASE_NAME).
# ------------------------------------------------------------
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/DATABASE?appName=Cluster0
MONGODB_DATABASE=DATABASE

# ------------------------------------------------------------
# OpenAQ
# ------------------------------------------------------------
OPENAQ_API_URL=https://api.openaq.org/v3
OPENAQ_API_KEY=

# ------------------------------------------------------------
# Datadog
# ------------------------------------------------------------
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key
DATADOG_SITE=datadoghq.com

# ------------------------------------------------------------
# Pipeline Config
# ------------------------------------------------------------
FETCH_INTERVAL_SECONDS=300
# Số lần retry tối đa cho lỗi tạm thời (timeout, 5xx, mất mạng).
MAX_RETRIES=3
# Backoff gốc, tính theo base * 2^attempt: 10s -> 20s -> 40s (mặc định 10).
# Tổng thời gian chờ khi retry cạn = 70s, thoải mái trong chu kỳ
# FETCH_INTERVAL_SECONDS=300s nên scheduler không trễ nhịp.
RETRY_BACKOFF_SECONDS=10
# Trần số lần replay cho record cách ly (tránh retry vô hạn).
MAX_REPLAY_ATTEMPTS=5
# In-flight claim lease: worker crash giữa replay -> record in_flight
# có thể được claim lại sau 600s thay vì kẹt vĩnh viễn.
QUARANTINE_CLAIM_LEASE_SECONDS=600

QUARANTINE_RETENTION_DAYS=7
# Số ngày giữ dữ liệu air_quality: MongoDB TTL tự xóa record cũ hơn
# (0 = giữ mãi, không tạo TTL).
DATA_RETENTION_DAYS=30

# Chỉ có ý nghĩa KHI air_quality là time-series collection (đã bật ở Atlas):
# TTL trên time-series phải scope theo metaField, nên ta chốt meta-value
# (location_id) được giám sát - pipeline chỉ theo 1 vị trí, mặc định 4946813.
# (Atlas code 72: "TTL indexes on time-series collections require a
#  partialFilterExpression on the metaField".)
AIR_QUALITY_TTL_META=4946813

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# Số ngày giữ log pipeline (loguru tự xóa log cũ hơn).
LOG_RETENTION_DAYS=14
LOG_LEVEL=INFO
