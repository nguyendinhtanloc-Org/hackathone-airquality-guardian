# MongoDB

MONGODB_USERNAME="aaa"
MONGODB_PASSWORD="aaa"
MONGODB_URI="mongodb+srv://aaa:zHqukphHNPexKihc@cluster0.utdscbk.mongodb.net/aaa?appName=Cluster0"
MONGODB_DATABASE_NAME="aaa"
MONGODB_DATABASE_USERNAME="aaa"
MONGODB_DATABASE_PASSWORD="aaaaaa@Aa"
# OpenAQ API
OPENAQ_API_URL=https://api.openaq.org/v2/latest
OPENAQ_API_KEY=

# Datadog
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key
DATADOG_SITE=datadoghq.com

# Pipeline Config
FETCH_INTERVAL_SECONDS=300
# Số lần retry tối đa cho lỗi tạm thời (timeout, 5xx, mất mạng).
MAX_RETRIES=3
# Backoff gốc, tính theo base * 2^attempt: 10s -> 20s -> 40s (mặc định 10).
# Tổng thời gian chờ khi retry cạn = 70s, thoải mái trong chu kỳ
# FETCH_INTERVAL_SECONDS=300s nên scheduler không trễ nhịp.
# Nếu API OpenAQ hay timeout nặng, có thể tăng về 30 (tổng 210s).
RETRY_BACKOFF_SECONDS=10
# Trần số lần replay cho record cách ly (tránh retry vô hạn).
MAX_REPLAY_ATTEMPTS=5
# Time-out lease claim in-flight: worker crash giữa replay → record in_flight
# có thể được claim lại sau 600s thay vì kẹt vĩnh viễn.
QUARANTINE_CLAIM_LEASE_SECONDS=600

QUARANTINE_RETENTION_DAYS=7
# Số ngày giữ dữ liệu air_quality: MongoDB TTL index trên timestamp
# tự xóa record cũ hơn (0 = giữ mãi, không tạo TTL).
# Trước 27/10 biến này nằm im trong .env, không ai đọc — giờ có hiệu lực thật.
DATA_RETENTION_DAYS=30

# Logging
# Số ngày giữ log pipeline (loguru tự xóa log cũ hơn; giữ disk khỏi đầy).
LOG_RETENTION_DAYS=14
LOG_LEVEL=INFO