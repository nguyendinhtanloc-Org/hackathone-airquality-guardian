# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGODB_DATABASE=airquality

# OpenAQ API
OPENAQ_API_URL=https://api.openaq.org/v2/latest
OPENAQ_API_KEY=

# Datadog
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key
DATADOG_SITE=datadoghq.com

# Pipeline Config
FETCH_INTERVAL_SECONDS=300
# Số lần retry tối đa cho lỗi tạm thời (timeout, 5xx, mất mạng).
MAX_RETRIES=3
# Backoff gốc, tính theo base * 2^attempt: 30s -> 60s -> 120s.
# Tổng thời gian chờ khi retry cạn = 210s, nên để nhỏ hơn FETCH_INTERVAL_SECONDS
# để pipeline còn kịp chạy vòng tiếp theo.
RETRY_BACKOFF_SECONDS=30
QUARANTINE_RETENTION_DAYS=7
DATA_RETENTION_DAYS=30

# Logging
LOG_LEVEL=INFO